# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Authentication (Single Admin)
ADMIN_EMAIL=admin@outreach.local
ADMIN_PASSWORD=adminStrongPass2026!
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_2026
JWT_EXPIRES_IN=7d

# Database Configuration (Zero-cost SQLite)
DATABASE_PATH=./data/outreach.db

# Email Configuration (Nodemailer / Free Gmail App Password or Brevo)
# Options: gmail | brevo | smtp
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=Outreach Team
SMTP_FROM_EMAIL=your-email@gmail.com
EMAIL_DAILY_CAP=100
EMAIL_MIN_INTERVAL_SEC=20
EMAIL_MAX_INTERVAL_SEC=35

# WhatsApp Configuration
# Options: click-to-chat | session | cloud
WHATSAPP_PROVIDER=click-to-chat
WHATSAPP_DAILY_CAP=30
WHATSAPP_MIN_INTERVAL_SEC=30
WHATSAPP_MAX_INTERVAL_SEC=90
WHATSAPP_WARMUP_MODE=true

# Public Unsubscribe Base URL
UNSUBSCRIBE_BASE_URL=http://localhost:5000/unsubscribe

# Google Gemini AI Integration (Google Studio Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

